{
    "name": "uspdev/api-keys",
    "description": "Gerenciamento seguro de API keys associadas a modelos Laravel para integrações e consumo por inteligência artificial.",
    "type": "library",
    "minimum-stability": "dev",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "Uspdev\\ApiKeys\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Masaki Kawabata Neto",
            "email": "kawabata@usp.br"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0",
        "illuminate/encryption": "^12.0",
        "laravel/framework": "^12.0",
        "illuminate/hashing": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/validation": "^12.0",
        "illuminate/view": "^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Uspdev\\ApiKeys\\ApiKeyServiceProvider"
            ]
        }
    }
}
